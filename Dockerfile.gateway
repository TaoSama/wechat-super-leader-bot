FROM node:24-bookworm-slim AS toolchain
RUN npm install --global pnpm@11.8.0

FROM toolchain AS build
WORKDIR /app
COPY gateway/package.json gateway/pnpm-lock.yaml gateway/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY gateway/tsconfig.json ./
COPY gateway/src ./src
RUN pnpm run build && pnpm prune --prod

FROM node:24-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /app/package.json ./package.json
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist

RUN mkdir -p /etc/super-leader /var/lib/super-leader-gateway /tmp \
    && chown -R node:node /etc/super-leader /var/lib/super-leader-gateway /tmp

USER node

ENTRYPOINT ["node", "dist/index.js"]
CMD ["--run"]
