FROM --platform=$BUILDPLATFORM node:24-bookworm-slim AS toolchain
RUN npm install --global pnpm@11.8.0

FROM toolchain AS controller-build
WORKDIR /work/controller
COPY scripts/clean-build.mjs /work/scripts/clean-build.mjs
COPY controller/package.json controller/pnpm-lock.yaml controller/pnpm-workspace.yaml ./
COPY packages/wechat-text /work/packages/wechat-text
RUN pnpm install --frozen-lockfile
COPY controller/tsconfig.json ./
COPY controller/src ./src
RUN pnpm run build && pnpm prune --prod

FROM toolchain AS web-build
WORKDIR /web
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY web/ ./
RUN pnpm run build

FROM toolchain AS runtime-certificates
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

FROM node:24-bookworm-slim
ARG VCS_REF=unknown
LABEL org.opencontainers.image.revision=$VCS_REF
# Claude Code's Linux sandbox needs bubblewrap and socat. Codex prefers any bwrap on PATH
# over its bundled launcher and cannot start its sandbox with the Debian one, so bwrap is
# diverted off PATH and Claude Code finds it through sandbox.bwrapPath in managed settings.
RUN mkdir -p /usr/libexec/claude-sandbox \
    && dpkg-divert --local --rename --divert /usr/libexec/claude-sandbox/bwrap --add /usr/bin/bwrap \
    && apt-get update \
    && apt-get install -y --no-install-recommends python3 curl python3-bs4 python3-html2text bubblewrap socat \
    && rm -rf /var/lib/apt/lists/*
# Install on the target platform so the Codex and Claude Code native binaries match the deployed CPU.
# The controller refuses BACKGROUND_EXECUTOR=claude at startup when the Claude sandbox cannot start.
RUN npm install --global @openai/codex@0.163.0 @anthropic-ai/claude-code@2.1.311 \
    && npm cache clean --force \
    && mkdir -p /var/lib/super-leader-runtime/settings /var/lib/super-leader-runtime/background/workers /var/lib/super-leader-runtime/background/artifacts \
    && chown -R node:node /var/lib/super-leader-runtime
# Production dependencies copied across architectures must remain platform-independent.
ENV NODE_ENV=production WEB_DIST_DIR=/app/web SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt SOURCE_REVISION=$VCS_REF
WORKDIR /app
COPY --from=runtime-certificates /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=controller-build --chown=node:node /work/controller/package.json ./package.json
COPY --from=controller-build --chown=node:node /work/controller/node_modules ./node_modules
COPY --from=controller-build --chown=node:node /work/controller/dist ./dist
COPY --from=web-build --chown=node:node /web/dist ./web
COPY deploy/skills/ /etc/codex/skills/
COPY deploy/claude/managed-settings.json /etc/claude-code/managed-settings.json
RUN chmod -R go-w /etc/codex/skills
USER node
CMD ["node", "dist/index.js"]
