FROM --platform=$BUILDPLATFORM node:24-bookworm-slim AS toolchain
RUN npm install --global pnpm@11.8.0

FROM toolchain AS controller-build
WORKDIR /work/controller
COPY scripts/clean-build.mjs /work/scripts/clean-build.mjs
COPY controller/package.json controller/pnpm-lock.yaml controller/pnpm-workspace.yaml ./
COPY packages/wechat-text /work/packages/wechat-text
RUN pnpm install --frozen-lockfile
COPY controller/tsconfig.json ./
COPY controller/src ./src
RUN pnpm run build && pnpm prune --prod

FROM toolchain AS web-build
WORKDIR /web
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY web/ ./
RUN pnpm run build

FROM node:24-bookworm-slim
# Production dependencies copied across architectures must remain platform-independent.
ENV NODE_ENV=production WEB_DIST_DIR=/app/web
WORKDIR /app
COPY --from=controller-build --chown=node:node /work/controller/package.json ./package.json
COPY --from=controller-build --chown=node:node /work/controller/node_modules ./node_modules
COPY --from=controller-build --chown=node:node /work/controller/dist ./dist
COPY --from=web-build --chown=node:node /web/dist ./web
USER node
CMD ["node", "dist/index.js"]
