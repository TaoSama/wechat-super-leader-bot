FROM --platform=$BUILDPLATFORM node:24-bookworm-slim AS toolchain
RUN npm install --global pnpm@11.8.0

FROM toolchain AS build
WORKDIR /work/gateway
COPY scripts/clean-build.mjs /work/scripts/clean-build.mjs
COPY gateway/package.json gateway/pnpm-lock.yaml gateway/pnpm-workspace.yaml ./
COPY gateway/patches ./patches
RUN pnpm install --frozen-lockfile --fetch-timeout=1200000
COPY gateway/tsconfig.json ./
COPY gateway/src ./src
RUN pnpm run build
RUN mkdir -p /runtime/etc/super-leader /runtime/var/lib/super-leader-gateway

FROM toolchain AS runtime-dependencies
ARG TARGETARCH
WORKDIR /work/gateway
COPY gateway/package.json gateway/pnpm-lock.yaml gateway/pnpm-workspace.yaml ./
COPY gateway/patches ./patches
# Select the target CLI package without running the installer under CPU emulation.
RUN case "$TARGETARCH" in amd64) CODEX_CPU=x64 ;; arm64) CODEX_CPU=arm64 ;; *) exit 1 ;; esac \
    && printf '\nsupportedArchitectures:\n  os: [linux]\n  cpu: [%s]\n  libc: [glibc]\n' "$CODEX_CPU" >> pnpm-workspace.yaml \
    && pnpm install --prod --frozen-lockfile --fetch-timeout=1200000

FROM node:24-bookworm-slim
ARG VCS_REF=unknown
LABEL org.opencontainers.image.revision=$VCS_REF
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /work/gateway/package.json ./package.json
COPY --from=runtime-dependencies --chown=node:node /work/gateway/node_modules ./node_modules
COPY --from=build --chown=node:node /work/gateway/dist ./dist
COPY --from=build --chown=node:node /runtime/etc/super-leader /etc/super-leader
COPY --from=build --chown=node:node /runtime/var/lib/super-leader-gateway /var/lib/super-leader-gateway

USER node

ENTRYPOINT ["node", "dist/index.js"]
CMD ["--run"]
